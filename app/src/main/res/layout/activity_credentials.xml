<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- 全局固定极光漫射图层 (Skia RenderEffect 硬件加速高斯模糊) -->
    <View
        android:id="@+id/global_aurora"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@drawable/bg_aurora_top_right"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部统一标题栏 (52dp, 半透卡片白 card_glass, 细分割线) -->
        <LinearLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <FrameLayout
                android:id="@+id/cred_back"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_back_chip"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_expand"
                    android:rotation="90"
                    app:tint="@color/primary" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="访问地址与鉴权凭据"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/transparent" />

        <!-- 滚动内容区 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="32dp">

                <!-- 分组 1: 设备桥 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="6dp"
                    android:letterSpacing="0.06"
                    android:text="设备桥"
                    android:textAllCaps="true"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.deepseekharness.app.ui.ModernCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    app:cardRadius="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_settings_icon_box">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_key"
                                app:tint="@color/primary" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="设备桥令牌（Bridge Token）"
                            android:textColor="@color/text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/cred_bridge_token"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_input"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="2dp"
                        android:padding="12dp"
                        android:text="（尚未生成）"
                        android:textColor="@color/text"
                        android:textIsSelectable="true"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/cred_copy_bridge_token"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:background="@drawable/m3_btn_primary_expressive"
                            android:paddingHorizontal="16dp"
                            android:stateListAnimator="@animator/btn_press_scale"
                            android:text="复制令牌"
                            android:textAllCaps="false"
                            android:textColor="@color/accent_on"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.deepseekharness.app.ui.ModernCardView>

                <!-- 分组 2: 本机访问 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:letterSpacing="0.06"
                    android:text="本机访问"
                    android:textAllCaps="true"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.deepseekharness.app.ui.ModernCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    app:cardRadius="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_settings_icon_box">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_globe"
                                app:tint="@color/primary" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="本机 Web 访问地址"
                            android:textColor="@color/text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="带 Launch Token"
                            android:textColor="@color/ok"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/cred_auth_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_input"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="2dp"
                        android:padding="12dp"
                        android:text="（服务未启动）"
                        android:textColor="@color/text"
                        android:textIsSelectable="true"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/cred_copy_auth_url"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:background="@drawable/m3_btn_primary_expressive"
                            android:paddingHorizontal="16dp"
                            android:stateListAnimator="@animator/btn_press_scale"
                            android:text="复制"
                            android:textAllCaps="false"
                            android:textColor="@color/accent_on"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/cred_enter_web"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/m3_btn_tonal_expressive"
                            android:paddingHorizontal="16dp"
                            android:stateListAnimator="@animator/btn_press_scale"
                            android:text="进入 Web"
                            android:textAllCaps="false"
                            android:textColor="@color/primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.deepseekharness.app.ui.ModernCardView>

                <!-- 分组 3: 局域网 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:letterSpacing="0.06"
                    android:text="局域网"
                    android:textAllCaps="true"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.deepseekharness.app.ui.ModernCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    app:cardRadius="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_settings_icon_box">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_wifi"
                                app:tint="@color/primary" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="局域网访问地址"
                            android:textColor="@color/text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/cred_lan_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_chip"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="已开启"
                            android:textColor="@color/ok"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.deepseekharness.app.ui.DshaToggle
                            android:id="@+id/cred_lan_switch"
                            android:layout_width="44dp"
                            android:layout_height="26dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/cred_lan_addr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_input"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="2dp"
                        android:padding="12dp"
                        android:text="（局域网未开启）"
                        android:textColor="@color/text"
                        android:textIsSelectable="true"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/cred_copy_lan_addr"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:background="@drawable/m3_btn_primary_expressive"
                            android:paddingHorizontal="16dp"
                            android:stateListAnimator="@animator/btn_press_scale"
                            android:text="复制"
                            android:textAllCaps="false"
                            android:textColor="@color/accent_on"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/cred_regenerate_token"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/m3_btn_danger_soft"
                            android:paddingHorizontal="16dp"
                            android:stateListAnimator="@animator/btn_press_scale"
                            android:text="重新生成"
                            android:textAllCaps="false"
                            android:textColor="@color/err"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.deepseekharness.app.ui.ModernCardView>

                <!-- 底部状态提示 Banner (纯 Skia ModernCardView, 柔和微底色) -->
                <com.deepseekharness.app.ui.ModernCardView
                    android:id="@+id/cred_status_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    app:cardRadius="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/ok" />

                        <TextView
                            android:id="@+id/cred_banner_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="局域网模式已开启，可直接在同 WiFi 设备上访问"
                            android:textColor="@color/ok"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.deepseekharness.app.ui.ModernCardView>

                <!-- 底部关闭胶囊按钮 (高度 44dp, 带有按压微缩放动效) -->
                <Button
                    android:id="@+id/cred_close"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/m3_btn_tonal_expressive"
                    android:stateListAnimator="@animator/btn_press_scale"
                    android:text="关闭"
                    android:textAllCaps="false"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
