<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="20dp">

    <!-- 弹窗主体卡片 (纯 Skia ModernCardView: 20dp 圆角, 1dp 玻璃边框, 柔光高斯外阴影) -->
    <com.deepseekharness.app.ui.ModernCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        app:cardRadius="20dp">

        <!-- 1. 顶部标题行: 40dp 图标框 + 导出插件包标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/m3_btn_tonal_expressive">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_plugins"
                    app:srcCompat="@drawable/ic_plugins"
                    app:tint="@color/primary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="导出插件包"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. 说明与全选/反选操作栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dialogExportSub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="选择要导出的插件："
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/dialogExportToggleAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                android:text="全选"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. 插件列表容器 (限制最大高度可滚动，内嵌 bg_input 容器) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/dialogExportScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:overScrollMode="never"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/dialogExportListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>

        <!-- 4. 底部说明提示 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.3"
            android:text="• 导出格式为 .tar.gz 归档包\n• 导出包可在其他 dsh 插件市场中直接导入使用"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <!-- 5. 底部操作按钮行 (高度 44dp, 间距 10dp) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDialogCancel"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/m3_btn_tonal_expressive"
                android:elevation="0dp"
                android:stateListAnimator="@animator/btn_press_scale"
                android:text="取消"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDialogConfirm"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1.2"
                android:background="@drawable/m3_btn_primary_expressive"
                android:elevation="4dp"
                android:outlineAmbientShadowColor="#00000000"
                android:outlineProvider="background"
                android:outlineSpotShadowColor="#3847699F"
                android:stateListAnimator="@animator/btn_press_scale"
                android:text="确认导出"
                android:textAllCaps="false"
                android:textColor="@color/accent_on"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

    </com.deepseekharness.app.ui.ModernCardView>

</FrameLayout>
