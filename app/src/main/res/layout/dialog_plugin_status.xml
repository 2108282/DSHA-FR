<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="20dp">

    <!-- 弹窗主体卡片 (纯 Skia ModernCardView: 20dp 圆角, 1dp 玻璃边框, 柔光高斯外阴影) -->
    <com.deepseekharness.app.ui.ModernCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        app:cardRadius="20dp">

        <!-- 1. 顶部标题行: 40dp 图标框 + 标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_settings_icon_box">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_plugins"
                    app:srcCompat="@drawable/ic_plugins"
                    app:tint="@color/primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/dialogStatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="插件管理功能"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. 内嵌结构化说明面板 (bg_input 样式半透玻璃槽) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="14dp">

            <TextView
                android:id="@+id/dialogStatusMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.4"
                android:textColor="@color/text"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 3. 底部操作按钮行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDialogStatusClose"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/m3_btn_primary_expressive"
                android:elevation="4dp"
                android:outlineAmbientShadowColor="#00000000"
                android:outlineProvider="background"
                android:outlineSpotShadowColor="#3847699F"
                android:stateListAnimator="@animator/btn_press_scale"
                android:text="知道了"
                android:textAllCaps="false"
                android:textColor="@color/accent_on"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

    </com.deepseekharness.app.ui.ModernCardView>

</FrameLayout>
