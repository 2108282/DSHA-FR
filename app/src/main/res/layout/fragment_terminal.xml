<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部统一标题栏 (52dp, 半透卡片白 card_glass, 细分割线) -->
        <LinearLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_settings_icon_box">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_terminal"
                    app:tint="@color/primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="简易终端"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="原生 Root · 流式命令执行"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 操作胶囊: 中止 (红色警告) -->
            <TextView
                android:id="@+id/term_ctrlc"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/m3_btn_danger_soft"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:stateListAnimator="@animator/btn_press_scale"
                android:text="中止"
                android:textColor="@color/err"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- 操作胶囊: 清理 -->
            <TextView
                android:id="@+id/term_clear"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/m3_btn_tonal_expressive"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:stateListAnimator="@animator/btn_press_scale"
                android:text="清理"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- 操作胶囊: PTY -->
            <TextView
                android:id="@+id/term_pty"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/m3_btn_tonal_expressive"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:stateListAnimator="@animator/btn_press_scale"
                android:text="PTY"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/transparent" />

        <!-- 终端主体工作区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- 纯 Skia ModernCardView 终端卡片 (18dp 圆角, 微阴影, 昼白/夜黑自适应背景) -->
            <com.deepseekharness.app.ui.ModernCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToOutline="true"
                android:orientation="vertical"
                app:cardRadius="18dp">

                <ScrollView
                    android:id="@+id/term_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/terminal_surface"
                    android:fillViewport="true"
                    android:overScrollMode="never"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/term_output"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:lineSpacingMultiplier="1.5"
                        android:textIsSelectable="true"
                        android:textColor="@color/terminal_text"
                        android:textSize="13sp" />
                </ScrollView>
            </com.deepseekharness.app.ui.ModernCardView>

            <!-- 底部命令输入栏 (高度 44dp, 胶囊输入框 + 发送按钮) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/term_input"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:fontFamily="monospace"
                    android:hint="输入命令，如 uname -a"
                    android:imeOptions="actionSend"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text_muted"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/term_send"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/m3_btn_primary_expressive"
                    android:minWidth="0dp"
                    android:paddingHorizontal="16dp"
                    android:stateListAnimator="@animator/btn_press_scale"
                    android:text="执行"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_on"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
