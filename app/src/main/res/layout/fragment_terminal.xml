<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_pad"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/page_pad"
    android:paddingBottom="@dimen/gap_control">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/gap_control">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/m3_card_expressive_item"
            android:fontFamily="monospace"
            android:paddingStart="@dimen/gap_control"
            android:paddingTop="9dp"
            android:paddingEnd="@dimen/gap_control"
            android:paddingBottom="9dp"
            android:text="Ubuntu · 原生 Root"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/term_ctrlc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/m3_btn_tonal_expressive"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="中止"
            android:textColor="@color/m3_secondary_on_container"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:id="@+id/term_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_tight"
            android:background="@drawable/m3_btn_tonal_expressive"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="清理"
            android:textColor="@color/m3_secondary_on_container"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:id="@+id/term_pty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_tight"
            android:background="@drawable/m3_btn_tonal_expressive"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="PTY"
            android:textColor="@color/m3_secondary_on_container"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_terminal"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/term_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <TextView
                android:id="@+id/term_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="@dimen/card_pad"
                android:textColor="@color/text_secondary"
                android:textIsSelectable="true"
                android:textSize="@dimen/text_caption" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/gap_tight">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="# "
                android:textColor="@color/ok"
                android:textSize="@dimen/text_caption" />

            <EditText
                android:id="@+id/term_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="monospace"
                android:hint="输入命令，回车执行"
                android:imeOptions="actionSend"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textColorHint="@color/text_muted"
                android:textSize="@dimen/text_label" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
