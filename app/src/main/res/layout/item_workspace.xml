<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_pill"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 顶行: 图标 + 标题 + 徽标组 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/item_ws_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_box"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/item_ws_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.deepseekharness.app.ui.ModernBadgeView
            android:id="@+id/item_ws_badge_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp" />

        <com.deepseekharness.app.ui.ModernBadgeView
            android:id="@+id/item_ws_badge_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- 中行: 物理路径 -->
    <TextView
        android:id="@+id/item_ws_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingMultiplier="1.2"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- 底行: 会话数量指示 + 右侧操作按钮组 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/item_ws_sessions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <Button
            android:id="@+id/item_ws_btn_switch"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_btn_small_tonal"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:stateListAnimator="@animator/btn_press_scale"
            android:text="设为当前"
            android:textAllCaps="false"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/item_ws_btn_delete"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_btn_danger_small"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:stateListAnimator="@animator/btn_press_scale"
            android:text="注销"
            android:textAllCaps="false"
            android:textColor="@color/err"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
