<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_pad">

        <Button
            android:id="@+id/update_back"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/m3_btn_tonal_expressive"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="‹ 返回"
            android:textAllCaps="false"
            android:textColor="@color/m3_secondary_on_container" />

        <TextView
            style="@style/DshaText.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="客户端与模块更新" />

        <TextView
            android:id="@+id/update_current"
            style="@style/DshaText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary" />

        <!-- 通道选择器卡片 -->
        <RadioGroup
            android:id="@+id/update_channels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/m3_card_expressive_item"
            android:padding="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/update_stable"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:buttonTint="@color/primary"
                android:text="稳定通道 (Stable)" />

            <RadioButton
                android:id="@+id/update_preview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:buttonTint="@color/primary"
                android:text="预览通道 (RC / Beta)" />
        </RadioGroup>

        <!-- 状态与日志卡片 -->
        <LinearLayout
            style="@style/DshaCard.Expressive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/update_status"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textIsSelectable="true" />

            <ProgressBar
                android:id="@+id/update_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/primary"
                android:max="100"
                android:visibility="gone" />

            <TextView
                android:id="@+id/update_bytes"
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/update_notes"
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp"
                android:textIsSelectable="true" />
        </LinearLayout>

        <Button
            android:id="@+id/update_cancel"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/m3_btn_tonal_expressive"
            android:text="取消下载 / 检查"
            android:textAllCaps="false"
            android:textColor="@color/err"
            android:visibility="gone" />

        <Button
            android:id="@+id/update_check"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="16dp"
            android:background="@drawable/m3_btn_primary_expressive"
            android:text="检查更新"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/m3_btn_primary_text" />

        <Button
            android:id="@+id/update_download"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/m3_btn_primary_expressive"
            android:text="下载更新"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/m3_btn_primary_text" />

        <Button
            android:id="@+id/update_install"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/m3_btn_primary_expressive"
            android:text="安装更新"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/m3_btn_primary_text" />

        <Button
            android:id="@+id/update_browser"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/m3_btn_tonal_expressive"
            android:text="在浏览器查看 GitHub Releases"
            android:textAllCaps="false"
            android:textColor="@color/m3_btn_tonal_text" />
    </LinearLayout>
</ScrollView>
