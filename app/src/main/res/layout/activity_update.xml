<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- 全局固定极光漫射图层 (1:1 对齐 HTML .aurora-1) -->
    <View
        android:id="@+id/global_aurora"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-110dp"
        android:layout_marginEnd="-80dp"
        android:background="@drawable/bg_aurora_top_right"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部标题栏 (52dp, 半透卡片白 card_glass, 细分割线) -->
        <LinearLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/card_glass"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_settings_refresh"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="检查更新"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_theme"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_chip_clickable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:stateListAnimator="@animator/chip_press_scale"
                android:text="日间"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line_soft" />

        <!-- 滚动内容区 -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="48dp">

                <!-- 返回胶囊按钮 (.back-btn) -->
                <LinearLayout
                    android:id="@+id/update_back"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_back_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:stateListAnimator="@animator/chip_press_scale">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_nav_back"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="返回"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 大标题与版本号 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="客户端与模块更新"
                    android:textColor="@color/text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/update_current"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- 通道切换栏 (RadioGroup 封装成 1:1 分段样式) -->
                <RadioGroup
                    android:id="@+id/update_channels"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_channel_seg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <RadioButton
                        android:id="@+id/update_stable"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tab"
                        android:button="@null"
                        android:gravity="center"
                        android:text="稳定通道 (Stable)"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/update_preview"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tab"
                        android:button="@null"
                        android:gravity="center"
                        android:text="预览通道 (RC / Beta)"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </RadioGroup>

                <!-- 更新状态卡片 (.gcard: ModernCardView) -->
                <com.deepseekharness.app.ui.ModernCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    app:cardRadius="18dp">

                    <TextView
                        android:id="@+id/update_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="正在检查更新…"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/update_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="12dp"
                        android:indeterminateTint="@color/primary"
                        android:max="100"
                        android:progressDrawable="@drawable/progress_capsule_horizontal"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/update_bytes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/update_notes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingMultiplier="1.5"
                        android:textColor="@color/text_secondary"
                        android:textIsSelectable="true"
                        android:textSize="12sp" />
                </com.deepseekharness.app.ui.ModernCardView>

                <!-- 操作按钮组 -->
                <Button
                    android:id="@+id/update_check"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/m3_btn_primary_expressive"
                    android:elevation="3dp"
                    android:outlineAmbientShadowColor="#00000000"
                    android:outlineSpotShadowColor="#3847699F"
                    android:stateListAnimator="@animator/btn_press_scale"
                    android:text="检查更新"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_on"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/update_download"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/m3_btn_primary_expressive"
                    android:elevation="3dp"
                    android:outlineAmbientShadowColor="#00000000"
                    android:outlineSpotShadowColor="#3847699F"
                    android:stateListAnimator="@animator/btn_press_scale"
                    android:text="下载更新"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_on"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/update_cancel"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/m3_btn_danger_soft"
                    android:stateListAnimator="@animator/btn_press_scale"
                    android:text="取消下载 / 检查"
                    android:textAllCaps="false"
                    android:textColor="@color/err"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/update_install"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/m3_btn_primary_expressive"
                    android:elevation="3dp"
                    android:outlineAmbientShadowColor="#00000000"
                    android:outlineSpotShadowColor="#3847699F"
                    android:stateListAnimator="@animator/btn_press_scale"
                    android:text="安装更新"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_on"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/update_browser"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/m3_btn_tonal_expressive"
                    android:stateListAnimator="@animator/btn_press_scale"
                    android:text="在浏览器查看 GitHub Releases"
                    android:textAllCaps="false"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>
