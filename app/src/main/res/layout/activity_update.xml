<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- 全局固定极光漫射图层 (Skia RenderEffect 硬件加速高斯模糊) -->
    <View
        android:id="@+id/global_aurora"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@drawable/bg_aurora_top_right"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部标题栏 (52dp, 与大背景 @color/surface 颜色完全一致, 细分割线) -->
        <LinearLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_settings_refresh"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="检查更新"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- 纯图标太阳/月亮切换胶囊 (36dp x 36dp, 纯图标, 零文字) -->
            <FrameLayout
                android:id="@+id/btn_theme"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_chip_clickable"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@animator/chip_press_scale">

                <ImageView
                    android:id="@+id/img_theme_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="切换主题"
                    android:src="@drawable/ic_sun"
                    app:tint="@color/text_secondary" />
            </FrameLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/transparent" />

        <!-- 滚动内容区 -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="48dp">

                <!-- 返回胶囊按钮 (.back-btn) -->
                <LinearLayout
                    android:id="@+id/update_back"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_back_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:stateListAnimator="@animator/chip_press_scale">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_nav_back"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="返回"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 大标题与版本号 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="版本发布与更新"
                    android:textColor="@color/text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/update_current"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/update_current_core"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="当前 DSH 核心版本：正在读取…"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- 通道切换栏 (RadioGroup 封装成分段选项卡) -->
                <RadioGroup
                    android:id="@+id/update_channels"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_channel_seg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <RadioButton
                        android:id="@+id/update_stable"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tab"
                        android:button="@null"
                        android:gravity="center"
                        android:text="客户端与模块"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/update_preview"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tab"
                        android:button="@null"
                        android:gravity="center"
                        android:text="原生 DSH 核心"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </RadioGroup>

                <!-- 更新信息卡片 (.gcard: ModernCardView) -->
                <com.deepseekharness.app.ui.ModernCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    app:cardRadius="18dp">

                    <TextView
                        android:id="@+id/update_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="正在拉取最新 Release 信息…"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/update_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="12dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/primary"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/update_notes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingMultiplier="1.5"
                        android:textColor="@color/text_secondary"
                        android:textIsSelectable="true"
                        android:textSize="12sp" />
                </com.deepseekharness.app.ui.ModernCardView>

                <!-- 操作按钮组 1: 通用「在浏览器查看」按钮 -->
                <Button
                    android:id="@+id/update_browser"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/m3_btn_tonal_expressive"
                    android:stateListAnimator="@animator/btn_press_scale"
                    android:text="在浏览器查看"
                    android:textAllCaps="false"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- 操作按钮组 2: 「原生 DSH 核心」专属更新命令按钮区 -->
                <LinearLayout
                    android:id="@+id/layout_core_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/update_copy_cmd"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:background="@drawable/m3_btn_primary_expressive"
                        android:elevation="3dp"
                        android:outlineAmbientShadowColor="#00000000"
                        android:outlineSpotShadowColor="#3847699F"
                        android:stateListAnimator="@animator/btn_press_scale"
                        android:text="复制更新命令"
                        android:textAllCaps="false"
                        android:textColor="@color/accent_on"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/update_copy_mirror_cmd"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/m3_btn_tonal_expressive"
                        android:stateListAnimator="@animator/btn_press_scale"
                        android:text="使用国内源更新"
                        android:textAllCaps="false"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>
