<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="24dp">

    <!-- 顶部弹性弹簧 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 104dp x 104dp 极光拟态英雄 Logo 卡片 (24dp 圆角, Skia 双层数学阴影) -->
    <com.deepseekharness.app.ui.ModernCardView
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:orientation="vertical"
        android:padding="0dp"
        app:cardRadius="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_about_logo_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="DS"
                android:textColor="@color/accent_on"
                android:textSize="40sp"
                android:textStyle="bold" />
        </FrameLayout>
    </com.deepseekharness.app.ui.ModernCardView>

    <!-- 主标题 DSHA-FR -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:letterSpacing="-0.015"
        android:text="DSHA-FR"
        android:textColor="@color/text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- 副标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="DeepSeek Harness 一键启动器"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- 核心特性说明文案 (用户指定: 内置 Linux 环境，无需 Termux。开箱即用。) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.6"
        android:text="内置 Linux 环境，无需 Termux。\n开箱即用。"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <!-- 底部弹性弹簧 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2" />

    <!-- 底部角本文案 (用户指定: 专为Root设备设计) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="专为Root设备设计"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

</LinearLayout>
