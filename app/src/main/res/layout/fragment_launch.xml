<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- 外层自适应滚动保护容器 (1:1 对齐 HTML 滚动行为，空间充足撑满，小屏/大字号平滑滚动) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <!-- 主体内容垂直容器 (.content: padding 14px 16px 14px; gap: 12px) -->
        <LinearLayout
            android:id="@+id/launch_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

        <!-- 1. DSH 运行状态与控制大卡片 (Status & Controls Card: border-radius 22dp, Skia 双层数学阴影) -->
        <com.deepseekharness.app.ui.ModernCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp"
            app:cardRadius="22dp">

            <!-- 上半部分: 状态展示区 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="18dp">

                <!-- 状态标题行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/launch_run_dot"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/dot_warn" />

                    <TextView
                        android:id="@+id/launch_run_state"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="正在启动"
                        android:textColor="@color/text"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 副文案 (font-size: 13sp; color: text_muted; margin-top: 6px) -->
                <TextView
                    android:id="@+id/launch_status"
                    style="@style/DshaText.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="正在解压内置环境并拉起 DSH 核心…"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <!-- 胶囊进度槽 (height: 4dp; margin-top: 14px; 1:1 对齐 HTML 38% 宽滑块 1.4s 循环滑动) -->
                <com.deepseekharness.app.ui.CapsuleProgressView
                    android:id="@+id/launch_busy"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="14dp" />
            </LinearLayout>

            <!-- 区域分隔线 (保持卡片内部结构统一) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="18dp"
                android:background="@color/line_soft" />

            <!-- 下半部分: 端口与启停控制区 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingTop="16dp"
                android:paddingBottom="18dp">

                <!-- 端口选择行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/DshaText.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="端口"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/launch_port_input"
                        android:layout_width="80dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_input"
                        android:gravity="center"
                        android:hint="3080"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="5"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/launch_port_chip_3080"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_clickable"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:stateListAnimator="@animator/btn_press_scale"
                        android:text="3080"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/launch_port_chip_3088"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_clickable"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:stateListAnimator="@animator/btn_press_scale"
                        android:text="3088"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 三大按钮 (height: 46px; border-radius: 14px; font-size: 15px; margin-top: 16px; gap: 8px) -->
                <LinearLayout
                    android:id="@+id/launch_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/launch_start"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1.2"
                        android:background="@drawable/m3_btn_primary_expressive"
                        android:elevation="4dp"
                        android:outlineAmbientShadowColor="#00000000"
                        android:outlineProvider="background"
                        android:outlineSpotShadowColor="#3847699F"
                        android:stateListAnimator="@animator/btn_press_scale"
                        android:text="启动"
                        android:textAllCaps="false"
                        android:textColor="@color/accent_on"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/launch_open"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/m3_btn_tonal_expressive"
                        android:elevation="0dp"
                        android:stateListAnimator="@animator/btn_press_scale"
                        android:text="重启"
                        android:textAllCaps="false"
                        android:textColor="@color/primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/launch_stop"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/m3_btn_danger_soft"
                        android:elevation="0dp"
                        android:stateListAnimator="@animator/btn_press_scale"
                        android:text="停止"
                        android:textAllCaps="false"
                        android:textColor="@color/err"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.deepseekharness.app.ui.ModernCardView>

        <!-- 3. 模块功能卡片 (1:1 严格对齐设置页模块卡片规范: 38dp 图标盒, 66dp 分割线, 统一双行标题与右箭头) -->
        <com.deepseekharness.app.ui.ModernCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToOutline="true"
            android:orientation="vertical"
            android:padding="0dp"
            app:cardRadius="18dp">

            <!-- 行 1: 局域网连接 (单击进入下级凭证页, 长按复制链接) -->
            <LinearLayout
                android:id="@+id/launch_lan_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="15dp">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_settings_icon_box">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="局域网连接"
                        android:src="@drawable/ic_wifi"
                        app:tint="@color/primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="局域网连接"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/launch_lan_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="局域网访问未授权"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_muted" />
            </LinearLayout>

            <!-- 细分割线 (避开左侧 38dp 图标盒，对齐文字边缘) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="66dp"
                android:background="@color/line_soft" />

            <!-- 行 2: 模型管理 -->
            <LinearLayout
                android:id="@+id/launch_models"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="15dp">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_settings_icon_box">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="模型管理"
                        android:src="@drawable/ic_box"
                        app:tint="@color/primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="模型管理"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="服务商·API配置"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_muted" />
            </LinearLayout>

            <!-- 细分割线 (避开左侧 38dp 图标盒，对齐文字边缘) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="66dp"
                android:background="@color/line_soft" />

            <!-- 行 3: 快捷对话 -->
            <LinearLayout
                android:id="@+id/launch_open_sheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="15dp">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_settings_icon_box">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="快捷对话"
                        android:src="@drawable/ic_chat"
                        app:tint="@color/primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="快捷对话"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="手势响应·点击唤起"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_muted" />
            </LinearLayout>
        </com.deepseekharness.app.ui.ModernCardView>

        <!-- 4. 运行追踪日志卡片 (border-radius: 18px; min-height: 120px; Skia 双层数学阴影) -->
        <com.deepseekharness.app.ui.ModernCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:minHeight="120dp"
            android:orientation="vertical"
            app:cardRadius="18dp">

            <!-- 头部 (padding: 12px 16px; border-bottom: 1px solid var(-line-soft)) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_terminal"
                    app:srcCompat="@drawable/ic_terminal"
                    app:tint="@color/primary" />

                <TextView
                    style="@style/DshaText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="运行追踪 · dsh-web.log"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line_soft" />

            <!-- 终端日志内容区 (padding: 12px 16px; background: var(-terminal); color: var(-terminal-text)) -->
            <ScrollView
                android:id="@+id/launch_log_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_terminal_bottom_rounded"
                android:fillViewport="true"
                android:nestedScrollingEnabled="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/launch_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingMultiplier="1.6"
                    android:text="还没有日志。"
                    android:textColor="#C9D5E5"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </ScrollView>
        </com.deepseekharness.app.ui.ModernCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

    <!-- Web 全屏与抽屉覆盖层容器 -->
    <FrameLayout
        android:id="@+id/launch_web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/launch_web_box"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

</FrameLayout>
