<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:id="@+id/launch_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad"
        android:paddingTop="@dimen/gap_tight"
        android:paddingEnd="@dimen/page_pad"
        android:paddingBottom="@dimen/gap_control">

        <!-- M3 Expressive 主控大卡片 -->
        <LinearLayout
            style="@style/DshaCard.Expressive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/launch_run_dot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/launch_run_state"
                    style="@style/DshaText.Display"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="20sp"
                    android:text="DSH 未运行" />
            </LinearLayout>

            <TextView
                android:id="@+id/launch_status"
                style="@style/DshaText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:textColor="@color/text_muted" />

            <ProgressBar
                android:id="@+id/launch_busy"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/progress_thin"
                android:layout_marginTop="@dimen/gap_tight"
                android:indeterminate="true"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_block"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/DshaText.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="端口："
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary" />

                <EditText
                    android:id="@+id/launch_port_input"
                    style="@style/DshaText.Body"
                    android:layout_width="85dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:hint="3080"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="5"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/launch_port_chip_3080"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_clickable"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="3080"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/launch_port_chip_3088"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_clickable"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="3088"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/launch_port_chip_8080"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_clickable"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="8080"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/launch_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_block"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/launch_start"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height"
                    android:layout_weight="1.2"
                    android:background="@drawable/m3_btn_primary_expressive"
                    android:text="启动"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_btn_primary_text"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/launch_open"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height"
                    android:layout_marginStart="@dimen/gap_tight"
                    android:layout_weight="1"
                    android:background="@drawable/m3_btn_tonal_expressive"
                    android:text="重启"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_btn_tonal_text"
                    android:textSize="@dimen/text_body" />

                <Button
                    android:id="@+id/launch_stop"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height"
                    android:layout_marginStart="@dimen/gap_tight"
                    android:layout_weight="1"
                    android:background="@drawable/m3_btn_tonal_expressive"
                    android:text="停止"
                    android:textAllCaps="false"
                    android:textColor="@color/err"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <TextView
                android:id="@+id/lan_addr"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/btn_height"
                android:layout_marginTop="@dimen/gap_block"
                android:background="@drawable/m3_card_expressive_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="@dimen/gap_control"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/gap_control"
                android:paddingBottom="12dp"
                android:textColor="@color/text"
                android:visibility="gone" />

            <Button
                android:id="@+id/launch_open_sheet"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="@dimen/gap_tight"
                android:background="@drawable/m3_btn_tonal_expressive"
                android:text="💬 打开快捷对话抽屉"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />
        </LinearLayout>

        <!-- M3 日志卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/gap_section"
            android:layout_weight="1"
            android:background="@drawable/m3_card_expressive"
            android:padding="16dp"
            android:orientation="vertical">

            <TextView
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/gap_tight"
                android:letterSpacing="0.04"
                android:textStyle="bold"
                android:text="运行追踪 · dsh-web.log" />

            <ScrollView
                android:id="@+id/launch_log_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/launch_log"
                    style="@style/DshaText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:paddingTop="@dimen/gap_hair"
                    android:paddingBottom="@dimen/gap_hair"
                    android:text="还没有日志。"
                    android:textColor="@color/text_secondary"
                    android:textIsSelectable="true" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/launch_web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/launch_web_box"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</FrameLayout>
