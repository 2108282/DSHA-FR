<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- Main content -->
    <LinearLayout
        android:id="@+id/launch_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad"
        android:paddingTop="@dimen/gap_tight"
        android:paddingEnd="@dimen/page_pad"
        android:paddingBottom="@dimen/gap_control">

        <!-- Hero status card -->
        <LinearLayout
            style="@style/DshaCard.Expressive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/launch_run_dot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/launch_run_state"
                    style="@style/DshaText.Display"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DSH 未运行"
                    android:textSize="22sp" />
            </LinearLayout>

            <!-- Status line -->
            <TextView
                android:id="@+id/launch_status"
                style="@style/DshaText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tight"
                android:textColor="@color/text_muted" />

            <!-- Progress bar -->
            <ProgressBar
                android:id="@+id/launch_busy"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/progress_thin"
                android:layout_marginTop="@dimen/gap_tight"
                android:indeterminate="true"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />

            <!-- Port row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_block"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/DshaText.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="端口："
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/launch_port_input"
                    style="@style/DshaText.Body"
                    android:layout_width="85dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:hint="3080"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="5"
                    android:paddingHorizontal="6dp"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/launch_port_chip_3080"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_clickable"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="3080"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/launch_port_chip_3088"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_clickable"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="3088"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/launch_port_chip_8080"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_clickable"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="8080"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Button row -->
            <LinearLayout
                android:id="@+id/launch_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_block"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/launch_start"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height"
                    android:layout_weight="1.2"
                    android:background="@drawable/m3_btn_primary_expressive"
                    android:text="启动"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_btn_primary_text"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/launch_open"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height"
                    android:layout_marginStart="@dimen/gap_tight"
                    android:layout_weight="1"
                    android:background="@drawable/m3_btn_tonal_expressive"
                    android:text="重启"
                    android:textAllCaps="false"
                    android:textColor="@color/m3_btn_tonal_text"
                    android:textSize="@dimen/text_body" />

                <Button
                    android:id="@+id/launch_stop"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height"
                    android:layout_marginStart="@dimen/gap_tight"
                    android:layout_weight="1"
                    android:background="@drawable/m3_btn_tonal_expressive"
                    android:text="停止"
                    android:textAllCaps="false"
                    android:textColor="@color/err"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <!-- LAN address card -->
            <TextView
                android:id="@+id/lan_addr"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_block"
                android:background="@drawable/m3_card_expressive_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="@dimen/btn_height"
                android:padding="12dp"
                android:textColor="@color/text"
                android:visibility="gone" />

            <!-- Sheet button -->
            <Button
                android:id="@+id/launch_open_sheet"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="@dimen/gap_tight"
                android:background="@drawable/m3_btn_tonal_expressive"
                android:text="💬 打开快捷对话抽屉"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Log card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/gap_section"
            android:layout_weight="1"
            android:background="@drawable/m3_card_expressive"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Log header -->
            <TextView
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:paddingBottom="@dimen/gap_tight"
                android:text="运行追踪 · dsh-web.log"
                android:textStyle="bold" />

            <!-- Log scroll -->
            <ScrollView
                android:id="@+id/launch_log_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/launch_log"
                    style="@style/DshaText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:paddingVertical="@dimen/gap_hair"
                    android:text="还没有日志。"
                    android:textColor="@color/text_secondary"
                    android:textIsSelectable="true" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- Web overlay -->
    <FrameLayout
        android:id="@+id/launch_web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/launch_web_box"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

</FrameLayout>
