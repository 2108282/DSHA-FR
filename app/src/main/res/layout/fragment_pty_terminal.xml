<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_pad"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/page_pad"
    android:paddingBottom="@dimen/gap_control">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/gap_control">

        <TextView
            android:id="@+id/pty_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/m3_card_expressive_item"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:paddingStart="@dimen/gap_control"
            android:paddingTop="9dp"
            android:paddingEnd="@dimen/gap_control"
            android:paddingBottom="9dp"
            android:text="Ubuntu · PTY"
            android:textColor="@color/text"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:id="@+id/pty_font_dec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_tight"
            android:background="@drawable/m3_btn_tonal_expressive"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="A−"
            android:textColor="@color/text"
            android:textSize="@dimen/text_label" />

        <TextView
            android:id="@+id/pty_font_inc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_tight"
            android:background="@drawable/m3_btn_tonal_expressive"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="A+"
            android:textColor="@color/text"
            android:textSize="@dimen/text_label" />

        <TextView
            android:id="@+id/pty_simple"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap_tight"
            android:background="@drawable/m3_btn_tonal_expressive"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="简易"
            android:textColor="@color/text"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_terminal"
        android:padding="@dimen/gap_tight">

        <com.termux.view.TerminalView
            android:id="@+id/pty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/terminal_surface"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </FrameLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_tight"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/pty_keys"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>
</LinearLayout>
