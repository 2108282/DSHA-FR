<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_pad">

        <Button
            android:id="@+id/link_install_close"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/m3_btn_tonal_expressive"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="关闭"
            android:textAllCaps="false"
            android:textColor="@color/m3_secondary_on_container" />

        <TextView
            style="@style/DshaText.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="第三方插件安装" />

        <!-- M3 详情卡片 -->
        <LinearLayout
            style="@style/DshaCard.Expressive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/link_install_status"
                style="@style/DshaText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textIsSelectable="true" />

            <TextView
                android:id="@+id/link_install_details"
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp"
                android:textIsSelectable="true" />
        </LinearLayout>

        <Button
            android:id="@+id/link_install_confirm"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="24dp"
            android:background="@drawable/m3_btn_primary_expressive"
            android:text="解析链接"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/m3_btn_primary_text" />

        <Button
            android:id="@+id/link_install_manage"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/m3_btn_tonal_expressive"
            android:text="打开插件管理"
            android:textAllCaps="false"
            android:textColor="@color/m3_btn_tonal_text" />
    </LinearLayout>
</ScrollView>
