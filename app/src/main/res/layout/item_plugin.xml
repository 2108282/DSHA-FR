<?xml version="1.0" encoding="utf-8"?>
<com.deepseekharness.app.ui.ModernCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:clickable="true"
    android:focusable="true"
    android:clipToOutline="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardRadius="18dp">

    <!-- 1. 插件头部主行 (gap: 12px; align-items: flex-start) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <!-- 中间信息栏 (.plugin-main) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 插件名称与状态徽章行 (.plugin-name) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pluginName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/text"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <!-- 纯 Skia 自绘胶囊状态徽章 (.badge: height 20px; border-radius 999px; 固定优先保留) -->
                <com.deepseekharness.app.ui.ModernBadgeView
                    android:id="@+id/pluginStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- 版本与来源元数据 (.plugin-meta: text-muted; 12sp) -->
            <TextView
                android:id="@+id/pluginStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <!-- 详细描述 (.plugin-desc: text-secondary; 12sp) -->
            <TextView
                android:id="@+id/pluginDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.3"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- 右侧自绘极简胶囊开关 (44px x 26px, 180ms cubic-bezier 缓动白圆球) -->
            <com.deepseekharness.app.ui.DshaToggle
                android:id="@+id/pluginToggle"
                android:layout_width="44dp"
                android:layout_height="26dp"
                android:layout_marginTop="4dp" />

            <!-- 仅指示卡片展开状态，点击由卡片统一处理。 -->
            <ImageView
                android:id="@+id/pluginExpandIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_down" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. 点击卡片展开下方详情 (padding: 12px 14px; background raised-glass; border-radius 14px) -->
    <LinearLayout
        android:id="@+id/pluginDetailsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <!-- 详细元信息 (开发者/依赖/权限/路径) -->
        <TextView
            android:id="@+id/pluginDetailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.8"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <!-- 单个插件更新与回退操作行 -->
        <LinearLayout
            android:id="@+id/pluginUpdateRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1">

                <Button
                    android:id="@+id/btnPluginUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/m3_btn_tonal_expressive"
                    android:elevation="0dp"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@animator/btn_press_scale"
                    android:text="更新"
                    android:textAllCaps="false"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/pluginUpdateProgress"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="8dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indeterminateTint="@color/primary" />
            </FrameLayout>

            <Button
                android:id="@+id/btnPluginRollback"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/m3_btn_tonal_small"
                android:elevation="0dp"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:stateListAnimator="@animator/btn_press_scale"
                android:text="回退上一版"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 四大操作小按钮行 (height: 32px; gap: 8px) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPluginAddr"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/m3_btn_tonal_small"
                android:elevation="0dp"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:stateListAnimator="@animator/btn_press_scale"
                android:text="地址"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPluginRename"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/m3_btn_tonal_small"
                android:elevation="0dp"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:stateListAnimator="@animator/btn_press_scale"
                android:text="名称"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPluginExport"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/m3_btn_tonal_small"
                android:elevation="0dp"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:stateListAnimator="@animator/btn_press_scale"
                android:text="导出"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPluginUninstall"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/btn_danger_outline"
                android:elevation="0dp"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:stateListAnimator="@animator/btn_press_scale"
                android:text="卸载"
                android:textAllCaps="false"
                android:textColor="@color/err"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</com.deepseekharness.app.ui.ModernCardView>
