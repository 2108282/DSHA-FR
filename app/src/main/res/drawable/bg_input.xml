<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card" />
            <corners android:radius="@dimen/radius_control" />
            <stroke android:width="2dp" android:color="@color/primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/m3_input_background" />
            <corners android:radius="@dimen/radius_control" />
            <stroke android:width="@dimen/stroke" android:color="@color/m3_input_stroke" />
        </shape>
    </item>
</selector>
