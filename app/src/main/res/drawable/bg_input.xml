<?xml version="1.0" encoding="utf-8"?>
<!-- 严格对齐 HTML: border-radius: 14px; background: rgba(240,242,245,.72); border: 1px solid rgba(229,231,235,.55); -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card" />
            <stroke
                android:width="1.5dp"
                android:color="@color/primary" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/raised_glass" />
            <stroke
                android:width="1dp"
                android:color="@color/line_soft" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
