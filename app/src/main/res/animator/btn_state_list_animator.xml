<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="translationZ" android:valueFrom="2dp" android:valueTo="6dp" android:valueType="floatType" android:duration="100" android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
        </set>
    </item>
    <item android:state_enabled="false">
        <set>
            <objectAnimator android:propertyName="translationZ" android:valueTo="0dp" android:valueType="floatType" android:duration="0" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="translationZ" android:valueFrom="6dp" android:valueTo="2dp" android:valueType="floatType" android:duration="200" android:interpolator="@android:anim/decelerate_interpolator" />
        </set>
    </item>
</selector>
