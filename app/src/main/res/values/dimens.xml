<?xml version="1.0" encoding="utf-8"?>
<!--
  M3 Expressive 2024~2025 设计 token：间距 / 圆角 / 字号 / 控件尺寸统一定义。
  布局只引用不硬编码，保证所有页面视觉一致性与呼吸感。
-->
<resources>

    <!-- ========== 间距（4 的倍数，形成节奏感） ========== -->
    <dimen name="page_pad">20dp</dimen>
    <dimen name="page_pad_wide">32dp</dimen>
    <dimen name="card_pad">16dp</dimen>
    <dimen name="gap_section">20dp</dimen>
    <dimen name="gap_block">16dp</dimen>
    <dimen name="gap_control">12dp</dimen>
    <dimen name="gap_tight">8dp</dimen>
    <dimen name="gap_hair">4dp</dimen>

    <!-- ========== 圆角阶梯 — 恢复原本控件规格 ========== -->
    <dimen name="radius_expressive_container">24dp</dimen>
    <dimen name="radius_expressive_card">18dp</dimen>
    <dimen name="radius_expressive_item">14dp</dimen>
    <dimen name="radius_expressive_button">14dp</dimen>
    <dimen name="radius_card">18dp</dimen>
    <dimen name="radius_control">14dp</dimen>
    <dimen name="radius_small">10dp</dimen>
    <dimen name="radius_pill">999dp</dimen>
    <dimen name="radius_appbar">16dp</dimen>

    <!-- M3 Expressive Shape Token 扩展 -->
    <dimen name="radius_dialog">20dp</dimen>
    <dimen name="bottom_nav_indicator_radius">14dp</dimen>
    <dimen name="radius_fab">16dp</dimen>
    <dimen name="radius_search">14dp</dimen>
    <dimen name="radius_avatar">14dp</dimen>

    <!-- ========== 字号阶梯 ========== -->
    <dimen name="text_hero">28sp</dimen>
    <dimen name="text_display">24sp</dimen>
    <dimen name="text_headline">20sp</dimen>
    <dimen name="text_title">17sp</dimen>
    <dimen name="text_body">15sp</dimen>
    <dimen name="text_label">13sp</dimen>
    <dimen name="text_caption">12sp</dimen>
    <dimen name="text_overline">11sp</dimen>

    <!-- ========== 控件尺寸 ========== -->
    <dimen name="btn_height">48dp</dimen>
    <dimen name="btn_height_large">56dp</dimen>
    <dimen name="input_height">46dp</dimen>
    <dimen name="touch_min">44dp</dimen>
    <dimen name="progress_thin">3dp</dimen>
    <dimen name="progress_bold">6dp</dimen>
    <dimen name="stroke">1dp</dimen>
    <dimen name="stroke_medium">1.5dp</dimen>

    <!-- ========== 导航与 AppBar ========== -->
    <dimen name="appbar_height">56dp</dimen>
    <dimen name="appbar_height_large">120dp</dimen>
    <dimen name="nav_bar_height">80dp</dimen>
    <dimen name="nav_icon_size">24dp</dimen>
    <dimen name="nav_label_gap">4dp</dimen>

    <!-- ========== M3 Expressive Spacing Token ========== -->
    <dimen name="card_pad_expressive">16dp</dimen>
    <dimen name="page_top_pad">16dp</dimen>
    <dimen name="list_item_pad_vertical">14dp</dimen>
    <dimen name="list_item_pad_horizontal">16dp</dimen>
    <dimen name="chip_pad_horizontal">14dp</dimen>
    <dimen name="chip_pad_vertical">8dp</dimen>
    <dimen name="chip_height">36dp</dimen>

    <!-- ========== 阴影层级 ========== -->
    <dimen name="elevation_none">0dp</dimen>
    <dimen name="elevation_low">2dp</dimen>
    <dimen name="elevation_medium">4dp</dimen>
    <dimen name="elevation_high">8dp</dimen>
    <dimen name="elevation_highest">12dp</dimen>

    <!-- ========== 图标 ========== -->
    <dimen name="icon_xs">16dp</dimen>
    <dimen name="icon_sm">20dp</dimen>
    <dimen name="icon_md">24dp</dimen>
    <dimen name="icon_lg">32dp</dimen>
    <dimen name="icon_xl">48dp</dimen>

</resources>
