#!/bin/bash
SELF="rm"
REAL="/bin/rm"
[ ! -x "$REAL" ] && REAL="/usr/bin/rm"

# 1. 递归删除（-r/-R/--recursive）自动追加 --one-file-system
IS_RECURSIVE=0
for arg in "$@"; do
  case "$arg" in
    -*r*|-*R*|--recursive) IS_RECURSIVE=1 ;;
  esac
done

if [ "$IS_RECURSIVE" = "1" ]; then
  case " $* " in
    *" --one-file-system "*) ;;
    *) set -- --one-file-system "$@" ;;
  esac
fi

# 2. 原有的确认拦截机制
if [ "${DSH_CONFIRM:-0}" = "1" ] || [ "${DSH_SHELL:-0}" = "1" ]; then
  if ! /root/dsh-confirm.sh "$SELF $*"; then
    echo "已拒绝: $SELF $*" >&2
    exit 1
  fi
fi

# 3. 执行真实命令
exec "$REAL" "$@"
