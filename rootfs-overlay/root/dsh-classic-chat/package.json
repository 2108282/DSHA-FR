{
  "name": "dsh-classic-chat",
  "version": "1.2.0",
  "description": "DSH 经典极速对话窗插件：屏蔽官方卡顿组件，自带 0.2.1 完整对话窗 + dsh-smooth-stream 二阶弹簧平滑流，深度兼容未来协议",
  "main": "lib/index.js",
  "type": "module",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.css",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "entry": "./lib/client.js",
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-attachment",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "chat",
    "ui",
    "smooth-stream",
    "typewriter",
    "plugin"
  ],
  "author": "2108282",
  "license": "MIT"
}
